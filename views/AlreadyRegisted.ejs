<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Already Registered</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-zinc-950 flex items-center justify-center overflow-hidden">

    <div class="absolute -top-20 -left-20 w-96 h-96 bg-red-600/20 rounded-full blur-[170px] animate-pulse"></div>
    <div class="absolute bottom-0 right-0 w-[450px] h-[450px] bg-red-500/10 rounded-full blur-[180px] animate-pulse"></div>

    <div class="relative w-full max-w-md mx-4 rounded-3xl bg-zinc-900/90 border border-zinc-800 shadow-2xl backdrop-blur-xl p-8">

        <div class="mx-auto flex h-24 w-24 items-center justify-center rounded-full bg-yellow-500 shadow-lg shadow-yellow-500/40">
            <span class="text-5xl">⚠️</span>
        </div>

        <h1 class="mt-6 text-center text-3xl font-bold text-white">
            Already Exists Account
        </h1>

        <p class="mt-4 text-center text-zinc-400 leading-7">
            An account with this email already exists.
            Please log in using your existing account.
        </p>

        <div class="mt-8 space-y-4">

            <a href="/login"
                class="block w-full rounded-xl bg-red-600 py-3 text-center text-lg font-semibold text-white transition hover:bg-red-700">
                Login Now
            </a>


        </div>

        <div class="mt-8 border-t border-zinc-800 pt-5 text-center">
            <p class="text-sm text-zinc-500">
                Need help? Contact support.
            </p>
        </div>

    </div>

</body>
</html>