<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body  class="bg-gradient-to-b from-zinc-900 to-zinc-800 min-h-screen relative">

    <div class="fixed inset-0 -z-10 overflow-hidden">
        <div class="absolute -top-40 -left-40 w-96 h-96 bg-red-600/30 rounded-full blur-[160px] animate-pulse"></div>
        <div class="absolute bottom-0 right-0 w-[450px] h-[450px] bg-red-500/20 rounded-full blur-[180px] animate-pulse"></div>
    </div>

    <nav class="flex items-center justify-between px-10 py-6 border-b border-zinc-800 bg-zinc-900/70 backdrop-blur-xl">
        <h1 class="text-3xl font-bold text-white">
            profile<span class="text-red-500">page</span>
        </h1>

        <a href="/logout"
            class="px-5 py-2 rounded-lg bg-red-600 hover:bg-red-700 transition text-white font-semibold">
            Logout   
        </a>
    </nav>

    <div class="max-w-5xl mx-auto mt-16 px-6">

        <div class="rounded-3xl overflow-hidden border border-zinc-800 bg-zinc-900 shadow-2xl">

            <div class="h-56 bg-gradient-to-r from-red-700 via-black to-red-900 relative">

                <div class="absolute -bottom-16 left-10 flex">

                      <div class=" w-32 h-32  rounded-full overflow-hidden border-4 border-zinc-900 shadow-lg">
                            <img src="/images/uploads/<%= user.profilepic %>" alt="" class="w-full h-full object-cover">
                            
                      </div>
                        

                </div>

            </div>

            <div class="pt-20 pb-10 px-10">
               <a  class="group relative overflow-hidden mt-3 mb-5 px-8 py-3 rounded-xl bg-gradient-to-r from-red-600 via-red-500 to-red-700 text-white font-bold shadow-lg shadow-red-600/40 transition-all duration-300 hover:scale-105 hover:shadow-red-500/70 hover:-translate-y-1 active:scale-95" href="/profile/upload">Edit peofile</a>

                <div class="flex flex-col md:flex-row md:justify-between md:items-center">
                  
                    <div>
                     <h2 class="text-4xl font-bold text-white mt-5" >
                            <%= user.name %>
                        </h2>
                           
                       

                        <p class="text-red-400 mt-2">
                            @<%= user.username %>
                        </p>

                        <p class="text-zinc-400 mt-2">
                            <%= user.email %>
                        </p>
                          

                    </div>

                  

                </div>

                <div class="grid grid-cols-2 md:grid-cols-4 gap-5 mt-10">
                   

                    <div class="bg-zinc-800 rounded-2xl p-6 text-center">
                        <h3 class="text-3xl font-bold text-white">24</h3>
                        <p class="text-zinc-400 mt-2">Posts</p>
                    </div>

                    <div class="bg-zinc-800 rounded-2xl p-6 text-center">
                        <h3 class="text-3xl font-bold text-white">350</h3>
                        <p class="text-zinc-400 mt-2">Followers</p>
                    </div>

                    <div class="bg-zinc-800 rounded-2xl p-6 text-center">
                        <h3 class="text-3xl font-bold text-white">180</h3>
                        <p class="text-zinc-400 mt-2">Following</p>
                    </div>

                    <div class="bg-zinc-800 rounded-2xl p-6 text-center">
                        <h3 class="text-3xl font-bold text-white"><%= user.age %></h3>
                        <p class="text-zinc-400 mt-2">Age</p>
                    </div>

                </div>
                 <div >
                    <form action="/post" method="POST" class="mt-10">
                        <textarea name="content" id="" class="mt-4 w-full h-20 rounded-lg bg-zinc-900 border border-zinc-800 px-4 py-2 text-white focus:outline-none focus:ring-2 mb-5 focus:ring-red-500" placeholder="What's in your mind?"></textarea>
                            <button
                                type="submit"
                                class="group relative overflow-hidden mt-6 px-8 py-3 rounded-xl bg-gradient-to-r from-red-600 via-red-500 to-red-700 text-white font-bold shadow-lg shadow-red-600/40 transition-all duration-300 hover:scale-105 hover:shadow-red-500/70 hover:-translate-y-1 active:scale-95">

                                <span class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/30 to-transparent group-hover:translate-x-full transition-transform duration-1000"></span>

                                <span class="relative flex items-center justify-center gap-2">
                                🚀 Create Post
                                </span>

                            </button>                        

                    </form>

                <div class="mt-10">

                    <h2 class="text-2xl text-white font-bold mb-4">
                        Your Posts
                    </h2>
                    <% user.post.reverse().forEach(function(post){%>
                        <div class="bg-zinc-800 rounded-2xl p-6 text-zinc-300 leading-8 mt-4">
                        <h4 class="text-xl font-bold text-white"><%= user.username %></h4>
                     
                        <div><%= post.content %></div>
                            <small class="text-zinc-400 mt-2 mr-5"><%= post.likes.length %> likes</small>
                        <a class="mt-2   rounded-xl  text-blue-500  transition text-xl"  href="/like/<%= post._id %>">
                            <%= post.likes.indexOf(user._id) >= 0 ? 'Unlike' : 'Like' %>
                        </a>
                        <a class="mt-2   rounded-xl  text-gray-500  transition text-xl ml-5" href="/edit/<%= post._id %>">edit</a>
                        
                        
                    </div>
                   <% })   %>
                   
                   

                </div>

            </div>

        </div>
        

    </div>

            

</body>
</html>