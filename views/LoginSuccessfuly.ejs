<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Successful</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        body{
            background:#0f172a;
            background-image:
            radial-gradient(circle at top left,#1e293b,#0f172a 60%);
        }
    </style>
</head>
<body>

<div class="min-h-screen flex items-center justify-center">

    <div class="w-[450px] bg-slate-900 border border-slate-700 rounded-3xl p-10 shadow-2xl text-center">

        <div class="w-24 h-24 mx-auto rounded-full bg-green-500 flex items-center justify-center text-5xl">
            ✅
        </div>

        <h1 class="text-4xl font-bold text-white mt-8">
            Login Successful
        </h1>

        <p class="text-gray-400 mt-4 text-lg">
            Welcome back! You have successfully logged into your account.
        </p>


        <div class="mt-5">
            <a href="/login"
               class="inline-block bg-red-500 hover:bg-red-600 text-white px-8 py-3 rounded-xl text-lg font-semibold transition">
                Logout
            </a>
        </div>

    </div>

</div>

</body>
</html>