<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Change Profile Picture</title>

<script src="https://cdn.tailwindcss.com"></script>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    display:flex;
    justify-content:center;
    align-items:center;
    min-height:100vh;
    background:
    linear-gradient(rgba(0,0,0,.75),rgba(0,0,0,.75)),
    url("https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=1920&q=80");
    background-size:cover;
    background-position:center;
}

.glass-card{
    width:430px;
    padding:35px;
    border-radius:20px;
    background:rgba(20,20,20,.8);
    backdrop-filter:blur(12px);
    border:1px solid rgba(255,255,255,.1);
    box-shadow:0 15px 35px rgba(0,0,0,.5);
    animation:float 3s ease-in-out infinite;
}

@keyframes float{
    50%{
        transform:translateY(-8px);
    }
}

.title{
    text-align:center;
    color:#fff;
    font-size:30px;
    font-weight:bold;
    margin-bottom:30px;
}

.file-box{
    border:2px dashed #ef4444;
    border-radius:18px;
    height:250px;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    cursor:pointer;
    transition:.35s;
    background:rgba(255,255,255,.03);
}

.file-box:hover{
    background:rgba(239,68,68,.08);
    transform:scale(1.03);
}

.file-box .avatar{
    width:90px;
    height:90px;
    border-radius:50%;
    background:#ef4444;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:45px;
    color:white;
    margin-bottom:15px;
    box-shadow:0 0 20px rgba(239,68,68,.5);
}

.file-box h2{
    color:#fff;
    font-size:24px;
}

.file-box p{
    color:#cfcfcf;
    margin-top:10px;
    font-size:15px;
}

.file-box input{
    display:none;
}

.animated-btn{
    width:100%;
    margin-top:25px;
    padding:14px;
    border:none;
    border-radius:12px;
    background:#ef4444;
    color:white;
    font-size:18px;
    font-weight:bold;
    cursor:pointer;
    transition:.3s;
    margin-bottom: 5;
}

.animated-btn:hover{
    background:#dc2626;
    transform:translateY(-3px);
    box-shadow:0 0 20px rgba(239,68,68,.6);
}
</style>
</head>

<body>

<form action="/upload" method="POST" enctype="multipart/form-data" class="glass-card">

    <h1 class="title">Upload Profile Picture</h1>

    <label class="file-box">

        <div class="avatar">👤</div>

        <h2>Choose New Image</h2>

        <p>JPG, PNG, JPEG or WEBP</p>

        <input
            type="file"
            name="image"
            accept="image/*"
            required
        >

    </label>

    <input
        type="submit"
        value="Update Profile Picture"
        class="animated-btn md-5"
    >
    <a href="/profile" class="mt-40 ml-5 text-gray-500"   >Go Back to Profile</a>
</form>

</body>
</html>